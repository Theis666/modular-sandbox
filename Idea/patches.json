        { "order": 1, "text": "Zwei Sägezähne, einer eine Oktave tiefer, beide minimal gegeneinander verstimmt.", "focus": ["vco1", "vco2"] },
        { "order": 2, "text": "Erst Hochpass, dann Tiefpass: Der Hochpass nimmt Bauch weg, der Tiefpass formt den Brass-Ton.", "focus": ["hpf", "lpf"] },
        { "order": 3, "text": "Zwei Hüllkurven auf den Cutoff: eine langsame, leichte und eine schnelle, volle für das 'Anblasen'.", "focus": ["env1", "env2"] },
        { "order": 4, "text": "Chorus und viel Hall dazu. Pitch und Cutoff live mit Modwheel oder Aftertouch spielen.", "focus": ["chorus", "reverb"] }
      ],
      "sources": [
        { "title": "MusicRadar – 40 greatest synth sounds No 1: Blade Runner", "url": "https://musicradar.com/news/blade-runner-best-synth-sound", "usedFor": "Kompletter Patch in Fathom CM" },
        { "title": "Reverb Machine – Vangelis' Blade Runner Synth Sounds", "url": "https://reverbmachine.com/blog/vangelis-blade-runner-synth-sounds/", "usedFor": "Lexicon 224" }
      ]
    },

